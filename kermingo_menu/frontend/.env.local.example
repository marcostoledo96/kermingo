# URL del backend Express (Next.js lo lee en build con NEXT_PUBLIC_*).
# Desarrollo local con backend: http://localhost:3001
# Portfolio / modo demo (sin Railway): dejar vacío y usar NEXT_PUBLIC_MOCK_API=true
NEXT_PUBLIC_API_URL=http://localhost:3001

# Portfolio permanente sin backend: true
# En Vercel debe estar en true tras la baja de Railway.
NEXT_PUBLIC_MOCK_API=false

# Muestra credenciales demo en el login (también se activa solo con MOCK_API=true)
# NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true
